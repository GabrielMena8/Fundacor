# Vite + Sanity environment variables
# Copy this file to `.env` for local dev and set values.
# In Vercel, set these in Project Settings > Environment Variables.

# Required (browser-safe)
VITE_SANITY_PROJECT_ID=ut4uykcs
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-19

# Optional (server-side only; NEVER expose in browser)
# For server/admin usage in serverless functions, not in the client bundle
VITE_SANITY_READ_TOKEN=
VITE_SANITY_TOKEN=
